# CripSquare Forum Bulletin V2 — optional, server-side only.
# DO NOT place these values in VITE_* or NEXT_PUBLIC_* variables.
# Keep this feature OFF until approved migration, authentication, privacy
# and accessibility checks have passed in an isolated environment.

CRIPSQUARE_FORUM_BULLETIN_ENABLED=false

# Redis/Upstash REST API: required for search, posts and moderation when enabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRIPSQUARE_FORUM_RATE_PEPPER=

# Explicit opt-in and server-only analytics, disabled by default.
CRIPSQUARE_FORUM_POSTHOG_ENABLED=false
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
CRIPSQUARE_FORUM_ANALYTICS_PEPPER=

# Existing Auth0 and PostgreSQL settings are owned by the current CripSquare
# deployment. Do not add production secrets to this example.

# Exact origin for session-cookie forum write actions, required when bulletin is ON.
# Set separately for each protected preview; example only, never expose a live origin unintentionally.
CRIPSQUARE_FORUM_PUBLIC_ORIGIN=
